{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run-azurite",
      "type": "shell",
      "command": "azurite --inMemoryPersistence",
      "options": {
        "cwd": "${workspaceFolder}/.vscode"
      },
      "problemMatcher": {
        "fileLocation": "absolute",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Executing task.*$",
          "endsPattern": "^.*successfully listening at http://127.0.0.1:10002.*$"
        }
      },
      "isBackground": true
    },
    {
      "label": "clean-backend",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/src/backend"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "revealProblems": "onProblem",
        "close": true
      }
    },
    {
      "label": "build-backend",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/backend"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "revealProblems": "onProblem",
        "close": true
      }
    },
    {
      "label": "run-backend",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/src/backend/Cps.CaseManagement.Api/bin/Debug/net10.0",
        "env": {
          "DDEIOptions__MockBaseUrl": "http://localhost:7081"
        }
      },
      "command": "func start --no-build --verbose --password Cps.CaseManagement.Api",
      "isBackground": true,
      "problemMatcher": "$func-dotnet-watch"
    },
    {
      "label": "build-ui",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/src/ui-spa"
      },
      "command": "npm install",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "^.*$"
        }
      },
      "presentation": {
        "revealProblems": "onProblem",
        "close": true
      }
    },
    {
      "label": "run-ui",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/src/ui-spa",
        "env": {
          "VITE_GATEWAY_BASE_URL": "http://localhost:7072",
          "VITE_MOCK_API_SOURCE": "",
          "VITE_MOCK_AUTH": ""
        }
      },
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Executing task.*$",
          "endsPattern": "^.*ready in.*$"
        }
      }
    },
    {
      "label": "e2e",
      "type": "shell",
      "command": "./scripts/local.ci.sh",
      "options": {
        "cwd": "${workspaceFolder}/src/e2e"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "prepare-all",
      "dependsOrder": "parallel",
      "dependsOn": [
        "build-ui",
        "build-backend",
        "run-azurite"
      ]
    },
    {
      "label": "run-backend-and-mock",
      "dependsOrder": "parallel",
      "dependsOn": [
        "run-mock",
        "run-backend",
        "run-backend-file-transfer"
      ]
    },
    {
      "label": "build-and-run-all",
      "dependsOrder": "sequence",
      "dependsOn": [
        "prepare-all",
        "run-backend-and-mock",
        "run-ui"
      ],
      "problemMatcher": []
    },
    {
      "label": "build-and-run-all-and-e2e",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build-and-run-all",
        "e2e"
      ],
      "problemMatcher": []
    },
    {
      "label": "clean (functions)",
      "command": "dotnet",
      "args": [
        "clean",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "type": "process",
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/src/backend\\Cps.CaseManagement.Api"
      }
    },
    {
      "label": "build (functions)",
      "command": "dotnet",
      "args": [
        "build",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "type": "process",
      "dependsOn": "clean (functions)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/src/backend\\Cps.CaseManagement.Api"
      }
    },
    {
      "label": "clean release (functions)",
      "command": "dotnet",
      "args": [
        "clean",
        "--configuration",
        "Release",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "type": "process",
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/src/backend\\Cps.CaseManagement.Api"
      }
    },
    {
      "label": "publish (functions)",
      "command": "dotnet",
      "args": [
        "publish",
        "--configuration",
        "Release",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "type": "process",
      "dependsOn": "clean release (functions)",
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/src/backend\\Cps.CaseManagement.Api"
      }
    },
    {
      "type": "func",
      "dependsOn": "build (functions)",
      "options": {
        "cwd": "${workspaceFolder}/src/backend\\Cps.CaseManagement.Api/bin/Debug/net10.0"
      },
      "command": "host start",
      "isBackground": true,
      "problemMatcher": "$func-dotnet-watch"
    }
  ]
}